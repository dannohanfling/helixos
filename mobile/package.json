{
  "name": "helixos-mobile",
  "private": true,
  "description": "The HelixOS apps for iPhone and Android (H-626 Phase 2): a Capacitor shell around the live web app. Its own packages, so the web build never sees them.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#111318' --iconBackgroundColorDark '#111318' --splashBackgroundColor '#111318' --splashBackgroundColorDark '#111318'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-badge": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3"
  }
}
