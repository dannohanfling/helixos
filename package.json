{
  "name": "helixos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/migrate.ts",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --tsconfig tsconfig.json src/db/seed.ts",
    "db:bootstrap": "tsx --tsconfig tsconfig.json scripts/bootstrap.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:airtable": "tsx --tsconfig tsconfig.json scripts/import-airtable.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
