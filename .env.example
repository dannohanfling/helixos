# Local SQLite file (default). For hosting, point at Turso/libsql: libsql://your-db.turso.io
DATABASE_URL=file:./data/helixos.db
DATABASE_AUTH_TOKEN=

# 32+ random characters. Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# First-run setup: open /setup?token=THIS once to create your workspace and coach login. Unset = /setup is disabled.
SETUP_TOKEN=

# Optional: pull template content from your HelixOS Airtable base (scripts/import-airtable.ts)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appz2UoSLKvSr4OWQ

# Reminder emails and password resets go through SendGrid. Without a key they are logged to the console instead of sent.
SENDGRID_API_KEY=
# "Name <address>" or a bare address, on a domain verified in SendGrid. Production: HelixOS <helixos@evolveomega.com>
EMAIL_FROM="HelixOS <helixos@evolveomega.com>"
# Development / smoke tests only: point the adapter at scripts/mock-sendgrid.ts. Ignored in production.
EMAIL_API_URL=
CRON_SECRET=change-me
APP_URL=http://localhost:3000

# AI drafting runs on each member's own Anthropic or OpenAI key, connected on Settings. There is no house key.
# Development / smoke tests only: point both SDKs at scripts/mock-ai.ts. Ignored in production.
AI_BASE_URL=

# Integrations (Community Loyalty, GoHighLevel) are configured per workspace on /integrations by the coach.
# Inbound webhooks: POST /api/webhooks/community-loyalty and /api/webhooks/ghl with header x-helix-secret (never in the URL).
# Optional: only if you publish a GoHighLevel marketplace app. Its webhooks arrive signed (x-ghl-signature, Ed25519) and are
# verified with the public key shown in the HighLevel developer portal (PEM, or the raw key as base64/hex). Workflow webhooks don't need this.
GHL_WEBHOOK_PUBLIC_KEY=

# Guard: `npm run db:seed` refuses to create the demo workspace (known logins) on production or a remote database unless this is 1.
ALLOW_DEMO_SEED=

# Show the "Try the demo" buttons on the login page in production (they always show in development).
DEMO_LOGIN=0

# Optional: separate key for encrypting integration secrets at rest (falls back to SESSION_SECRET). 32+ characters.
ENCRYPTION_KEY=

# Optional: extra HTTPS hosts integrations may call, comma separated. Built-ins: services.leadconnectorhq.com, api.communityloyalty.app.
INTEGRATION_URL_ALLOWLIST=
